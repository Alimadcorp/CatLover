{
  "display_information": {
    "name": "Cat Lover",
    "description": "Runs :cat-chips: thread competitions.",
    "background_color": "#1e1e2e"
  },
  "features": {
    "bot_user": {
      "display_name": "Cat Lover",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "groups:history",
        "chat:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://YOUR_DEPLOYMENT_URL.com/api/slack/events",
      "bot_events": [
        "app_mention"
      ]
    },
    "interactivity": {
      "is_enabled": false
    },
    "socket_mode_enabled": false
  }
}